#!/bin/sh /etc/rc.common
# myMPD procd service

START=94
STOP=10
USE_PROCD=1
PROG=/usr/bin/mympd

start_service() {
	mkdir -p /var/lib/mympd /var/cache/mympd
	chown mympd:mympd /var/lib/mympd /var/cache/mympd 2>/dev/null

	procd_open_instance
	procd_set_param command "$PROG" -s -w /var/lib/mympd -a /var/cache/mympd
	procd_set_param user mympd
	procd_set_param group mympd
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "mympd"
}
